# Build outputs / installers
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.zip
*.tar.gz
*.7z

# NSIS installer
nsis/

# Runtime data
data/
*.db
*.sqlite
*.sqlite3

# Tauri / Rust build
src-tauri/target/
src-tauri/.tmp-target*/
src-tauri/.codex-dir-test2/
src-tauri/src-tauri/
target/
**/target/

# Node
node_modules/
dist/
build/
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs
*.log

# Python / local tooling
__pycache__/
*.py[cod]
.python-version
.venv/
venv/
env/
.python314/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temp files / directories
.tmp-target*/
.tmp-target-*/
.tmp_*
.tmp-*
tmp/
temp/
.cache/
.tmp_xdis*/

# Local test / extracted scratch outputs
hi-codex-src/
hi-codex-src-test/

# Edge preview browser profile (cookies / login data / session — never commit)
.edge-preview-profile/

# Build-time linker temp dir: keep the folder (needed by link.exe) but ignore its temp files
src-tauri/.build-tmp/*
!src-tauri/.build-tmp/.gitkeep

# Project local files
PLAN.md
.build-version
deploy-download-site.bat
src-tauri/varswitch-profiles.json
src-tauri/updater.key
codex-plugins/

# 本地开发日志与设计文档，不随仓库分发
dev-log.txt
docs/

# 下载站分发的安装包与签名都是构建产物。
# Tauri 更新器从 latest.json 内联的 signature 校验，不会去请求 .sig 文件。
varswitch-download-site/releases/

# deploy-download-site.bat 用于同步 macOS 产物的 GitHub Token，禁止入库
.github-token

# 各类 AI / 编辑器本地配置
# 注意：.github 不能加进来，CI 工作流必须随仓库上传
AGENTS.md
.claude
.codex
.cursor
.vscode
.agents
.superpowers
.playwright-cli
.playwright-mcp
%USERPROFILE%

