# Rust build artifacts are not application source changes.
target/

# A tool previously expanded this Windows variable as a literal project directory.
# Ignore it so any accidental recreation cannot restart `tauri dev` in a loop.
%USERPROFILE%/
# Same directory via its Windows 8.3 short name. A broken TEMP env var uses this
# form, making the MSVC linker drop lnk*.tmp files here during dev builds.
%USERP~1/

# 本地 UI 预览调试页，不进打包产物
public/__ui-preview.html
